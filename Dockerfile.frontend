# ==========================================
# Etapa 1: Compilación de Frontend (Angular 21)
# ==========================================
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ==========================================
# Etapa 2: Servidor Web Nginx con Reverse Proxy
# ==========================================
FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html

# Copiar bundle compilado de Angular
COPY --from=build /app/dist/leart-demo/browser/ .

# Copiar configuración de proxy inverso de Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
