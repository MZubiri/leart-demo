{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: start",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Changes detected",
          "endsPattern": "bundle generation (complete|failed)"
        }
      }
    },
    {
      "label": "npm: test",
      "type": "shell",
      "command": "npm test -- --watch=false",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "backend: test",
      "type": "shell",
      "command": "dotnet test backend/Leart.Api.Tests",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
